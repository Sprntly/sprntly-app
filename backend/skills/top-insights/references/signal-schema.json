{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "top-insights schemas",
  "description": "Adapters return `finding` objects from upstream analysis skills; the skill emits a `brief`, an updated `ledger`, and a ranked `backlog`. Numbers in the brief must trace to fields here — the skill phrases, it never computes.",
  "definitions": {
    "brief_config": {
      "type": "object",
      "description": "Resolved before anything else. Cadence and subscription change every downstream decision.",
      "required": [
        "recipient",
        "cadence",
        "categories"
      ],
      "properties": {
        "recipient": {
          "type": "string"
        },
        "cadence": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ]
        },
        "brief_interval_days": {
          "type": "integer",
          "enum": [
            1,
            7,
            30
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "customer_problems",
              "competitive",
              "reliability",
              "core_metric",
              "celebrate",
              "what_to_build"
            ]
          },
          "description": "What the recipient subscribed to. Unsubscribed categories are never fetched and never mentioned."
        },
        "core_goal": {
          "type": [
            "object",
            "null"
          ],
          "description": "Required for what_to_build. If null, that block says the goal isn't set rather than guessing.",
          "properties": {
            "statement": {
              "type": "string"
            },
            "metric": {
              "type": "string",
              "description": "Also the section label for the core_metric category."
            },
            "target": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "company_scale": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. ARR. Normalizes impact so the same figure doesn't rank the same everywhere."
        },
        "confidence_floor": {
          "type": "number",
          "default": 0.6
        },
        "card_budget": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Defaults by cadence: daily 3 (1-5), weekly 5 (3-7), monthly 6 (3-7)."
        },
        "selection_profile": {
          "$ref": "#/definitions/selection_profile"
        }
      }
    },
    "adapter_response": {
      "type": "object",
      "required": [
        "category",
        "source_skill",
        "available",
        "findings"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "source_skill": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "description": "When the upstream analysis RAN — not when it was fetched. All freshness logic depends on this."
        },
        "refresh_interval_days": {
          "type": "integer",
          "description": "Drives the fast/slow lane split against brief_interval_days."
        },
        "available": {
          "type": "boolean",
          "description": "false = unreachable or not wired. Category contributes nothing and is not mentioned."
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/finding"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "category",
        "type",
        "pain",
        "value",
        "story",
        "recommended_action",
        "sources",
        "confidence",
        "urgency",
        "as_of"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Must be STABLE across runs. The ledger, dismissal memory, and all freshness logic key off this."
        },
        "category": {
          "type": "string",
          "enum": [
            "customer_problems",
            "competitive",
            "reliability",
            "core_metric",
            "celebrate",
            "what_to_build"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "reliability",
            "retention",
            "competitive",
            "growth",
            "demand",
            "engagement",
            "compliance",
            "momentum"
          ],
          "description": "Nature of the finding. Drives the accent color only — the tag shows the category."
        },
        "pain": {
          "type": "object",
          "required": [
            "metric",
            "value"
          ],
          "properties": {
            "metric": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "number"
              ]
            },
            "context": {
              "type": "string"
            },
            "population": {
              "type": "string",
              "description": "Who the number is about. Required when channels disagree, so the body can name it."
            }
          }
        },
        "value": {
          "type": "object",
          "description": "What's at stake — becomes the second half of the title. Sizes the problem; does not promise the reward of a fix. amount may be null; if so the title sizes it qualitatively and NO number is invented.",
          "required": [
            "verb",
            "basis"
          ],
          "properties": {
            "verb": {
              "type": "string",
              "enum": [
                "recover",
                "protect",
                "add",
                "lift",
                "unlock",
                "save",
                "reduce"
              ],
              "description": "Retained for compatibility, but titles now size the stake rather than promising a fix. Prefer phrasing that states what is riding on the finding."
            },
            "metric": {
              "type": "string"
            },
            "amount": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "range": {
              "type": [
                "string",
                "null"
              ],
              "description": "Preferred over false precision for projections, e.g. '~$1.6M' or '+12-18 pts'."
            },
            "basis": {
              "type": "string",
              "description": "How the figure was derived. Required so the projection is auditable."
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "story": {
          "type": "string",
          "description": "One- to two-sentence cause. Must name its own subject, so the body stays self-contained."
        },
        "recommended_action": {
          "type": "string",
          "description": "What the PRD does. The skill never invents scope beyond this."
        },
        "channels_present": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "internal",
              "public",
              "direct"
            ]
          },
          "description": "customer_problems only. Which of the three feedback skills actually carried this. Chips must match."
        },
        "cluster_members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Upstream finding ids merged into this one. Makes the merge auditable."
        },
        "theme_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stable key for cross-channel clustering, if the upstream skill provides one."
        },
        "tension": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when channels disagree. Narrated in the body — never averaged away."
        },
        "prd_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "null -> CTA becomes 'Draft PRD'."
        },
        "prototype_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "null -> CTA becomes 'Generate prototype'."
        },
        "report_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "The parent report this finding came from. Any finding carrying this gets 'View the full report' as its primary CTA, linking out in a new tab."
        },
        "patch_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "reliability: an auto-generated fix. Switches CTAs to 'Review the fix'."
        },
        "incident_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "breakdown_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "core_metric: the metric breakdown view."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Render honestly — one source means one chip."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Concrete datapoints. At least one required to clear the gate — and it now backs the primary CTA, so it must be substantial enough to read."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "urgency": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reach": {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "enum": [
                "accounts",
                "users",
                "deals",
                "sessions"
              ]
            },
            "count": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "first_seen": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "in_progress",
            "resolved",
            "dismissed"
          ],
          "default": "open"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "Link to the evidence view. Primary CTA target for findings with no parent report."
        },
        "report_rank": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The report's own ranking of this finding. Rank 1 cards on the drop; the rest release across the interval at the release pace."
        }
      }
    },
    "ledger": {
      "type": "object",
      "description": "Carried between runs. Without stable finding ids this cannot work, and neither can the anti-staleness logic.",
      "properties": {
        "last_brief_at": {
          "type": "string",
          "format": "date-time"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "finding_id",
              "last_shown_at",
              "times_shown"
            ],
            "properties": {
              "finding_id": {
                "type": "string"
              },
              "last_shown_at": {
                "type": "string",
                "format": "date-time"
              },
              "last_shown_as": {
                "type": "string",
                "enum": [
                  "card",
                  "strip",
                  "what_to_build"
                ]
              },
              "times_shown": {
                "type": "integer"
              },
              "first_shown_at": {
                "type": "string",
                "format": "date-time"
              },
              "snapshot": {
                "type": "object",
                "description": "Values as last shown. Material-change detection diffs against this.",
                "properties": {
                  "pain_value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "value_amount": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "reach_count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "urgency": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                }
              },
              "user_action": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "dismissed",
                  "deferred",
                  "prd_generated",
                  "prd_approved",
                  "none",
                  null
                ],
                "description": "Three distinct meanings. dismissed = not interested, suppress unless it worsens. deferred = interested but not now, suppress for one refresh interval then return at full rank. prd_* = taken up, move to in_progress."
              },
              "retired": {
                "type": "boolean",
                "default": false,
                "description": "true after rotation exhaustion. Returns only on material change."
              },
              "deferred_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Set on defer. Defaults to one full refresh interval of the finding's source. On expiry the finding re-enters the pool at full rank — deferral is not a soft dismissal."
              },
              "dismiss_streak_key": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Groups dismissals of similar findings. Three in a row raises a pending_suggestion — a proposal to the reader, never an automatic weight change."
              }
            }
          }
        }
      }
    },
    "brief": {
      "type": "object",
      "required": [
        "recipient",
        "cadence",
        "greeting",
        "cards"
      ],
      "properties": {
        "recipient": {
          "type": "string"
        },
        "cadence": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "greeting": {
          "type": "string",
          "description": "Max 3 lines. Time framing must match cadence. Totals must equal the sum of figures in `cards` only."
        },
        "totals": {
          "type": "object",
          "properties": {
            "within_reach": {
              "type": "string"
            }
          }
        },
        "cards": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "category",
              "type",
              "accent",
              "title",
              "body",
              "sources",
              "ctas",
              "finding_id",
              "state"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "customer_problems",
                  "competitive",
                  "reliability",
                  "core_metric",
                  "celebrate",
                  "what_to_build"
                ],
                "description": "Routing metadata only — governs fetching, capping, and the audit trail. Never rendered."
              },
              "type": {
                "type": "string",
                "enum": [
                  "reliability",
                  "retention",
                  "competitive",
                  "growth",
                  "demand",
                  "engagement",
                  "compliance",
                  "momentum"
                ],
                "description": "Nature of the finding. Drives the accent color AND the rendered pill, exactly as before."
              },
              "accent": {
                "type": "string",
                "description": "Hex from the type taxonomy. Must match the type AND the valence."
              },
              "state": {
                "type": "string",
                "enum": [
                  "new",
                  "updated",
                  "carried_promoted"
                ],
                "description": "Only these three may occupy a card."
              },
              "title": {
                "type": "string",
                "description": "Pain stat + value of acting."
              },
              "body": {
                "type": "string",
                "description": "Self-contained, max 4 lines. Arc = what's happening (or what changed) -> what's at stake -> what this rests on."
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ctas": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "enum": [
                        "View the evidence",
                        "View the full report",
                        "Generate PRD",
                        "View PRD"
                      ]
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "primary",
                        "ghost"
                      ]
                    },
                    "ref": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "description": "Exactly two. Primary takes the reader to the basis for the claim (parent report, else evidence view). Ghost is the PRD, generated on demand."
              },
              "finding_id": {
                "type": "string"
              },
              "audit": {
                "type": "object",
                "description": "Why this surfaced and where its numbers came from.",
                "properties": {
                  "priority_score": {
                    "type": "number"
                  },
                  "figure_provenance": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "e.g. 'pain.value <- voice-of-customer/vc_882'"
                  },
                  "channels_present": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "surfaced_because": {
                    "type": "string"
                  },
                  "profile_version": {
                    "type": "integer",
                    "description": "Which selection_profile version produced this ranking."
                  },
                  "base_score": {
                    "type": "number"
                  },
                  "multipliers_applied": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    },
                    "description": "Every preference and focus multiplier that touched this finding, labeled. Answers 'why am I seeing this'."
                  },
                  "outranked": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Finding ids this beat for the slot."
                  },
                  "severity_override": {
                    "type": "boolean",
                    "default": false,
                    "description": "True when the finding bypassed the profile. The card must say so."
                  }
                }
              }
            }
          }
        },
        "backlog_count": {
          "type": "integer",
          "description": "Count of findings not surfaced this cycle. Rendered only if the product has a backlog page to link to."
        },
        "reports": {
          "type": "array",
          "description": "The report shelf. Standing links to every report behind the reader's subscribed categories, rendered below the cards. Static between runs by design — which is why it is a link row and not a card. Omitted entirely when empty.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "ref",
              "ran_at"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "e.g. 'Competitive review'"
              },
              "ref": {
                "type": "string",
                "description": "Stable report URL. Opens in a new tab."
              },
              "source_skill": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "Type taxonomy value, for the accent dot only."
              },
              "ran_at": {
                "type": "string",
                "format": "date",
                "description": "REQUIRED. Rendered on the row so the age is stated rather than implied."
              },
              "next_run": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "description": "null for on-demand sources like interview synthesis."
              },
              "summary": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ONE sentence, taken verbatim from the report's own summary. This skill never composes it — writing a fresh characterization of a report is how a confident, wrong summary reaches a PM. Null renders the row without a sentence rather than inventing one."
              }
            }
          }
        },
        "rendered_html": {
          "type": "string",
          "description": "Path to the rendered brief. Every run produces one — a run that emits only the structured object has not finished."
        }
      },
      "description": "Output object. The rendered brief is the existing weekly-brief design: greeting plus cards. Nothing else is emitted to the page."
    },
    "backlog": {
      "type": "array",
      "description": "Everything not on the brief, ranked, with the reason. The backlog page reads from this — nothing is lost, it's just not surfaced.",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority_score": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "below_confidence_floor",
              "no_evidence",
              "duplicate",
              "stale",
              "dismissed_unchanged",
              "below_scale_threshold",
              "rotation_exhausted",
              "slow_lane_between_refreshes",
              "below_card_budget",
              "category_cap_reached",
              "resolved",
              "excluded_by_profile",
              "deprioritized_by_profile",
              "deferred_by_reader"
            ]
          }
        }
      }
    },
    "selection_profile": {
      "type": "object",
      "description": "The reader's stated criteria for what they want to see. Written and edited by the reader, never inferred silently from behavior. Applied in SKILL.md step 4, after the objective gate and before freshness.",
      "properties": {
        "version": {
          "type": "integer",
          "description": "Increments on every edit. The audit trail records which version produced a given brief."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "statement": {
          "type": "string",
          "description": "The reader's own words, kept verbatim. The structured fields below are compiled from this and shown back for confirmation — the reader always sees what their sentence became."
        },
        "hard_filters": {
          "type": "array",
          "description": "Absolute exclusions. Findings matching these never appear, and land on the backlog with reason 'excluded_by_profile'. Overridable only by the severity override.",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "description": "e.g. value.amount, reach.unit, type, segment, surface"
              },
              "op": {
                "type": "string",
                "enum": [
                  "lt",
                  "gt",
                  "eq",
                  "neq",
                  "in",
                  "not_in"
                ]
              },
              "operand": {},
              "label": {
                "type": "string",
                "description": "Human-readable, shown on the backlog page so the reader can see why something was filtered."
              }
            }
          }
        },
        "preferences": {
          "type": "array",
          "description": "Weighted reordering. Never excludes — a deprioritized finding still appears if nothing better exists.",
          "items": {
            "type": "object",
            "properties": {
              "matches": {
                "type": "object",
                "description": "Which findings this applies to."
              },
              "multiplier": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2.0,
                "description": "Clamped to 0.5-2.0. Wider than this and it is a filter in disguise, which belongs in hard_filters where the reader can see it."
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "focus": {
          "type": [
            "object",
            "null"
          ],
          "description": "Standing emphasis tied to the core goal. Findings bearing on it get a modest lift; what_to_build reads directly from it.",
          "properties": {
            "description": {
              "type": "string"
            },
            "multiplier": {
              "type": "number",
              "default": 1.25
            },
            "expires": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          }
        },
        "severity_override_floor": {
          "type": "string",
          "enum": [
            "critical",
            "high"
          ],
          "default": "critical",
          "description": "Findings at or above this severity bypass hard_filters and preferences entirely, and say so on the card. Should fire a handful of times a year; if it fires weekly the bar is set wrong."
        },
        "pending_suggestions": {
          "type": "array",
          "description": "Profile changes proposed from observed behavior, awaiting explicit reader confirmation. NEVER auto-applied — a digest that learns to show only what you already engage with stops telling you what you don't know.",
          "items": {
            "type": "object",
            "properties": {
              "proposed_change": {
                "type": "object"
              },
              "evidence": {
                "type": "string",
                "description": "e.g. 'passed on 3 onboarding findings in a row'"
              },
              "raised_at": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "accepted",
                  "declined"
                ]
              }
            }
          }
        }
      }
    }
  }
}