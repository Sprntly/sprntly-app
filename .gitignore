__pycache__/
*.py[cod]
*.egg-info/
.venv
venv/
# Every .env variant, ignored by shape rather than by name. The old list named
# six specific suffixes, which meant a backup taken during an environment
# repoint (`.env.bak-prod`, `.env.bak-repoint-*` — BRANCHING.md tells you to
# make one) was NOT ignored and could be committed. This repo is public and
# these files hold service-role keys and TOKEN_ENCRYPTION_KEY, so a name the
# list happened not to anticipate is a world-readable credential leak.
.env
.env.*
# ...except the tracked templates, which carry no values.
!.env.example
*.log
.DS_Store
.idea/
.vscode/

# SQLite databases (generated, not source-of-truth)
*.db
*.db-journal
*.db-shm
*.db-wal

# Corpus data — generated/uploaded files per dataset (never commit client data)
backend/data/*/
!backend/data/.gitkeep

# Claude Code local state
.claude/
CLAUDE.md

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
.turbo/
out/
dist/
build/
.vercel/

# Design Agent generated artifacts (not source-of-truth).
# Per-company generated data dirs are ignored wholesale rather than listed by
# name — naming one here identifies that customer in a public repo. Already
# tracked files under backend/data/ are unaffected; .gitignore never untracks.
backend/data/*/
backend/data/prototypes/
web/public/prototype-bundles
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
