# SQLite databases (generated, not source-of-truth)
*.db
*.db-journal
*.db-shm
*.db-wal

# Corpus data — generated/uploaded files per dataset (never commit client data).
# Excluded at FILE level, not directory level: `backend/data/*/` stops git
# descending at all, so no later negation can re-include anything inside. That
# mattered — the demo corpus IS tracked, and issue #1238's step 3 moves it to a
# new directory, which would have `git add`ed nothing and failed silently.
# Markdown is the corpus format; everything generated is another extension.
backend/data/*/*
!backend/data/*/*.md
!backend/data/*/_reference/
!backend/data/*/_reference/*.md
!backend/data/.gitkeep

# Claude Code local state
.claude/
CLAUDE.md

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

